FROM dunglas/frankenphp:1-php8.5-alpine

# pdo_pgsql потрібен для Neon Postgres. У базовому образі він зазвичай уже є,
# тому ставимо тільки якщо його немає.
RUN php -m | grep -qi '^pdo_pgsql$' || install-php-extensions pdo_pgsql

# Сайт викликає header() (редіректи адмінки) вже після HTML — як на звичайному
# хостингу потрібен output buffering, інакше "headers already sent".
RUN printf '%s\n' \
        'output_buffering = 4096' \
        'expose_php = Off' \
        'session.save_path = /tmp/php-site/sessions' \
        'session.gc_maxlifetime = 86400' \
        'session.cookie_httponly = 1' \
        'session.cookie_samesite = Lax' \
        > /usr/local/etc/php/conf.d/zz-php-site.ini

WORKDIR /app

# Уся сайт у образі: деплой read-only, писати можна лише в /tmp.
COPY . /app
COPY Caddyfile /etc/caddy/Caddyfile

ENV SERVER_NAME=:80 \
    PHP_SESSION_SAVE_PATH=/tmp/php-site/sessions \
    PHP_OPCACHE_VALIDATE_TIMESTAMPS=0 \
    PHP_DISPLAY_ERRORS=0 \
    PHP_LOG_ERRORS=1

EXPOSE 80

# /tmp ефемерний на кожному інстансі — теки створюємо на старті, не в білді.
ENTRYPOINT ["/bin/sh", "-c", "mkdir -p /tmp/php-site/sessions /tmp/php-site/cache && exec /usr/local/bin/frankenphp run --config /etc/caddy/Caddyfile"]
